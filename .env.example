# Discord Bot Configuration
BOT_TOKEN=your_discord_bot_token_here

# Canvas API Configuration (defaults to https://tip.instructure.com if not specified)
CANVAS_API_URL=https://tip.instructure.com

# Optional: Restrict bot to specific server IDs (comma-separated, e.g. 123456789,987654321)
ALLOWED_GUILD_IDS=

# Optional: Path to SQLite database file inside container (default: /app/data/canvas_bot.db)
DATABASE_PATH=/app/data/canvas_bot.db

# Optional: Enable legacy direct DM broadcasts (deprecated: default false)
ENABLE_DM_BROADCASTS=false
